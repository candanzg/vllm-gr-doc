<mxfile host="app.diagrams.net">
  <diagram name="一次搜索的计算流 N=3" id="gr-compute-flow-n3">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1000" background="#F5F5DC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="一次推荐搜索的整图计算流（有效预算 N = 3，固定宽度 W）" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1200" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="三段 SID 只需一次 Prefill 的候选选择 + 两次 Decode forward；中间状态全程留在设备侧" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A5A45;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;前端&lt;/b&gt;&lt;br&gt;Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#8C5A5A;strokeWidth=1.2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="110" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;设备&lt;/b&gt;&lt;br&gt;Worker&lt;br&gt;GPU / NPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D9E6;strokeColor=#3A5A6C;strokeWidth=1.2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="110" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;回传&lt;/b&gt;&lt;br&gt;D2H" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6B8E5A;strokeWidth=1.2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="110" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F2;strokeColor=#C9A9A9;strokeWidth=1.2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="110" width="1360" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F8FC;strokeColor=#8FAAB8;strokeWidth=1.2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="320" width="1360" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8F0;strokeColor=#9DBB8C;strokeWidth=1.2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="740" width="1360" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;① 提交&lt;/b&gt;（一次）&lt;br&gt;GRLLM.beam_search_v1()&lt;br&gt;→ 一个 BeamBatchRequest&lt;br&gt;&lt;i&gt;B 个 item，batch_id 复用首个 request_id&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#8C5A5A;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="140" width="330" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;② Prefill&lt;/b&gt;&lt;br&gt;处理用户上下文&lt;br&gt;→ 取最后一行 logits&lt;br&gt;→ 约束 TopK 选出第一段 SID&lt;br&gt;→ 初始化设备 Beam 状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D9E6;strokeColor=#3A5A6C;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="350" width="300" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;约束 TopK&lt;/b&gt;&lt;br&gt;只在合法集 A 内挑候选&lt;br&gt;&lt;i&gt;但打分用共享词表窗口 V&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEB99;strokeColor=#8C7A3A;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="540" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;③ Decode #1&lt;/b&gt;&lt;br&gt;B×W 行展开&lt;br&gt;→ forward&lt;br&gt;→ 候选选择&lt;br&gt;→ 第二段 SID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D9E6;strokeColor=#3A5A6C;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="350" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;父索引重排后缀 KV&lt;/b&gt;&lt;br&gt;gather → 暂存 → scatter&lt;br&gt;&lt;i&gt;避免共享父节点被原位覆盖&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEB99;strokeColor=#8C7A3A;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="540" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;④ Decode #2&lt;/b&gt;&lt;br&gt;同上&lt;br&gt;→ 候选选择&lt;br&gt;→ 第三段 SID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D9E6;strokeColor=#3A5A6C;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="350" width="260" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;设备端排序打包&lt;/b&gt;&lt;br&gt;按累计分数排序&lt;br&gt;→ 拼成最终 payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEB99;strokeColor=#8C7A3A;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="540" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;⑤ 单份 D2H&lt;/b&gt;&lt;br&gt;一次设备到主机拷贝&lt;br&gt;&lt;i&gt;只有终态，没有中间 Beam 树&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6B8E5A;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="770" width="380" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;⑥ 构造输出&lt;/b&gt;&lt;br&gt;BeamSearchOutput&lt;br&gt;&lt;i&gt;lazy：文本在访问时才 decode&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6B8E5A;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="770" width="380" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFAF2;strokeColor=#A8A48F;strokeWidth=1.2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="330" width="330" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;三个要点&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5A5A45;" vertex="1" parent="1">
          <mxGeometry x="1216" y="340" width="300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;其一&lt;/b&gt;&lt;br&gt;N=3 &lt;b&gt;不是&lt;/b&gt;三次 Decode&lt;br&gt;&lt;i&gt;Prefill 已选出第一个 token，&lt;br&gt;所以只有两次 Decode forward&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C9BC8A;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1216" y="372" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;其二&lt;/b&gt;&lt;br&gt;中间状态不回主机&lt;br&gt;&lt;i&gt;获胜 token、累计分数、&lt;br&gt;父关系都留在设备侧&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C9BC8A;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1216" y="486" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;其三&lt;/b&gt;&lt;br&gt;选择在 item 内部&lt;br&gt;&lt;i&gt;B 个 item 展开为 B×W 行，&lt;br&gt;但候选只在各自 item 内竞争&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C9BC8A;strokeWidth=1.2;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1216" y="600" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C5A5A;strokeWidth=2.2;endArrow=classic;endSize=8;fontSize=10;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A5A6C;strokeWidth=1.6;endArrow=classic;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="26" value="第二段" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A5A6C;strokeWidth=2.2;endArrow=classic;endSize=8;fontSize=10;labelBackgroundColor=#F5F5DC;" edge="1" parent="1" source="11" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A5A6C;strokeWidth=1.6;endArrow=classic;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="28" value="第三段" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A5A6C;strokeWidth=2.2;endArrow=classic;endSize=8;fontSize=10;labelBackgroundColor=#F5F5DC;" edge="1" parent="1" source="13" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A5A6C;strokeWidth=1.6;endArrow=classic;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="15" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="30" value="终态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A5A6C;strokeWidth=2.2;endArrow=classic;endSize=8;fontSize=10;labelBackgroundColor=#F5F5DC;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="700"/><mxPoint x="370" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B8E5A;strokeWidth=2.2;endArrow=classic;endSize=8;fontSize=10;" edge="1" parent="1" source="17" target="18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
